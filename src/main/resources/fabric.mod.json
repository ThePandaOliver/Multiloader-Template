{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [${fabric_mod_authors}],
	"contact": {
		"issues": "https://github.com/ThePandaOliver/Multiloader-Template/issues",
		"sources": "https://github.com/ThePandaOliver/Multiloader-Template"
	},
	"license": "${mod_license}",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.template.TemplateModFabric"
		]
	},
	"mixins": [
		"${mod_id}.mixins.json"
	],
	"depends": {
		"fabric": ">=${loader_version}",
		"fabric-api": "*",
		"minecraft": "${minecraft_version}"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/wjPt4vEfXb",
				"modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/example",
				"modmenu.modrinth": "https://modrinth.com/mod/example",
				"modmenu.github_releases": "https://github.com/ThePandaOliver/Multiloader-Template/releases"
			},
			"badges": [
				"library"
			],
			"update_checker": true
		}
	}
}